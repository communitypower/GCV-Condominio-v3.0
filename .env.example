PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://gcv_user:gcv_password@localhost:5432/gcv_condominio?schema=public
SESSION_SECRET=gcv_local_dev_secret
BETA_ALLOWED_EMAILS=
# Local seed only. Never configure this variable in Railway environments.
SEED_PLATFORM_ADMIN_PASSWORD=

# Invitation delivery (optional). Without these values the API returns a manual link.
INVITATION_EMAIL_WEBHOOK_URL=
INVITATION_EMAIL_WEBHOOK_TOKEN=
PASSWORD_RESET_EMAIL_WEBHOOK_URL=
PASSWORD_RESET_EMAIL_WEBHOOK_TOKEN=

# Feature flags
ENABLE_AI_ASSISTANT=false
ENABLE_DOCUMENT_INGESTION=true
ENABLE_GITHUB_INTEGRATION=false
ENABLE_DEMO_EXPORTS=false

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini_api
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Document ingestion. In Railway, mount a persistent volume at this path.
DOCUMENT_STORAGE_PATH=uploads
DOCUMENT_MAX_FILE_SIZE_BYTES=20971520
DOCUMENT_PROCESSING_CONCURRENCY=2
DOCUMENT_RETENTION_DAYS=90
DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
DOCUMENT_MAX_TENANT_STORAGE_BYTES=1073741824
DOCUMENT_ANTIVIRUS_URL=
DOCUMENT_ANTIVIRUS_TOKEN=
DOCUMENT_OCR_URL=
DOCUMENT_OCR_TOKEN=

# GitHub OAuth/Gist demo integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth is intentionally unavailable during the controlled beta.
